{
  "author": {
    "email": "syn@syn.as",
    "name": "syn",
    "url": "https://github.com/synmux"
  },
  "bin": {
    "cco": "bin/cco.js",
    "claude-commit": "bin/cco.js"
  },
  "claude-commit": {
    "allowApiKey": false,
    "charsPerToken": 3.5,
    "conventionalCommits": true,
    "customPrompt": null,
    "filenamesOnly": false,
    "gitmoji": true,
    "interactive": false,
    "interactiveCount": 10,
    "interactiveTemperature": 1,
    "lowPriorityPaths": [
      ".agents/**",
      ".claude/**",
      "bun.lock",
      "pnpm-lock.yaml",
      ".serena"
    ],
    "maxChunkTokens": 750000,
    "models": {
      "final": "opus",
      "summary": "opus"
    },
    "multiline": true,
    "ollama": {
      "context": "auto",
      "host": "http://localhost:11434",
      "keepAlive": "10m"
    },
    "skipArmored": true,
    "spinner": "pong",
    "template": null
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.285",
    "@clack/core": "^1.5.1",
    "@clack/prompts": "^1.8.1",
    "cli-spinners": "^3.4.0",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "picomatch": "^4.0.7"
  },
  "description": "Generate git commit messages with Claude, using your Claude Code subscription and/or Ollama.",
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.285",
    "@biomejs/biome": "^2.5.15",
    "@trunkio/launcher": "^1.3.4",
    "@types/node": "^26.6.3",
    "@types/picomatch": "^4.0.3",
    "esbuild": "^0.28.2",
    "prettier": "3.9.9",
    "skilld": "^3.2.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^24.21.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "name": "@synmux/claude-commit",
  "packageManager": "pnpm@12.8.2",
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synmux/claude-commit.git"
  },
  "scripts": {
    "build": "esbuild bin/cco.ts index.ts --bundle --platform=node --format=esm --packages=external --outbase=. --outdir=dist && tsc -p tsconfig.build.json",
    "format": "prettier --write . && biome format --write . && trunk fmt -a",
    "lint": "trunk check -a",
    "lint:fix": "trunk check -a --fix",
    "lint:types": "tsc --noEmit",
    "prepare": "skilld prepare || true",
    "prepublishOnly": "pnpm run build",
    "start": "node bin/cco.js",
    "test": "vitest run"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "version": "1.1.0"
}
