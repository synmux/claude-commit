{
  "name": "@synmux/claude-commit",
  "version": "1.0.4",
  "description": "Generate git commit messages with Claude, using your Claude Code subscription and/or Ollama.",
  "main": "index.ts",
  "module": "index.ts",
  "type": "module",
  "private": false,
  "bin": {
    "cco": "bin/cco.ts",
    "claude-commit": "bin/cco.ts"
  },
  "files": [
    "bin",
    "src",
    "index.ts",
    "CHANGELOG.md"
  ],
  "claude-commit": {
    "allowApiKey": false,
    "charsPerToken": 3.5,
    "conventionalCommits": true,
    "customPrompt": null,
    "filenamesOnly": false,
    "gitmoji": true,
    "interactive": false,
    "interactiveCount": 10,
    "interactiveTemperature": 1,
    "lowPriorityPaths": [
      ".agents/**",
      ".claude/**",
      "bun.lock",
      ".serena"
    ],
    "maxChunkTokens": 32768,
    "models": {
      "summary": "ollama:gemma4:e4b-mlx",
      "final": "ollama:gemma4:e4b-mlx"
    },
    "multiline": true,
    "ollama": {
      "host": "http://localhost:11434",
      "context": "auto",
      "keepAlive": "10m"
    },
    "skipArmored": true,
    "spinner": "pong",
    "template": null
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.241",
    "@trunkio/launcher": "^1.3.4",
    "@types/bun": "^1.4.0",
    "prettier": "3.9.4",
    "skilld": "^2.3.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "@opentui/core": "^0.5.7",
    "cli-spinners": "^3.4.0",
    "commander": "^15.0.0",
    "ora": "^9.4.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synmux/claude-commit"
  },
  "scripts": {
    "start": "bun run bin/cco.ts",
    "test": "bun test",
    "format": "bun run prettier --write . && bun run trunk fmt -a",
    "lint": "bun run trunk check -a",
    "lint:fix": "bun run trunk check -a --fix",
    "typecheck": "bun run tsc --noEmit",
    "prepare": "bun run skilld prepare || true"
  },
  "trustedDependencies": [
    "@anthropic-ai/claude-code",
    "@google/genai",
    "onnxruntime-node",
    "protobufjs",
    "sharp"
  ]
}
