{
  "name": "@synmux/claude-commit",
  "version": "1.0.4",
  "description": "Generate git commit messages with Claude, using your Claude Code subscription and/or Ollama.",
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "private": false,
  "bin": {
    "cco": "bin/cco.js",
    "claude-commit": "bin/cco.js"
  },
  "files": [
    "bin",
    "dist",
    "CHANGELOG.md"
  ],
  "claude-commit": {
    "allowApiKey": false,
    "charsPerToken": 3.5,
    "conventionalCommits": true,
    "customPrompt": null,
    "filenamesOnly": false,
    "gitmoji": true,
    "interactive": false,
    "interactiveCount": 10,
    "interactiveTemperature": 1,
    "lowPriorityPaths": [
      ".agents/**",
      ".claude/**",
      "pnpm-lock.yaml",
      ".serena"
    ],
    "maxChunkTokens": 32768,
    "models": {
      "summary": "ollama:gemma4:e4b-mlx",
      "final": "ollama:gemma4:e4b-mlx"
    },
    "multiline": true,
    "ollama": {
      "host": "http://localhost:11434",
      "context": "auto",
      "keepAlive": "10m"
    },
    "skipArmored": true,
    "spinner": "pong",
    "template": null
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "^2.1.241",
    "@trunkio/launcher": "^1.3.4",
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.0",
    "esbuild": "^0.27.0",
    "prettier": "3.9.4",
    "skilld": "^2.3.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "@clack/core": "^1.4.3",
    "@clack/prompts": "^1.7.0",
    "cli-spinners": "^3.4.0",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "picomatch": "^4.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/synmux/claude-commit"
  },
  "scripts": {
    "start": "node bin/cco.js",
    "build": "esbuild bin/cco.ts index.ts --bundle --platform=node --format=esm --packages=external --outbase=. --outdir=dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "format": "prettier --write . && trunk fmt -a",
    "lint": "trunk check -a",
    "lint:fix": "trunk check -a --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "skilld prepare || true",
    "prepublishOnly": "pnpm run build"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c"
}
